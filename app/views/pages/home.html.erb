<h1>Blogs Post</h1>
<% @posts.find_each do |post|  %>
  <p><%= post.title %></p>
<% end %>

<h1>Skills</h1>
<% @skills.find_each do |skill|  %>
  <p><%= skill.title %> - <%= skill.percent_utilized %>%</p>
<% end %>

<h1>Portfolio Items</h1>
<% @portfolio_items.find_each do |portfolio_item|  %>
  <p><%= portfolio_item.title %></p>
<% end %>